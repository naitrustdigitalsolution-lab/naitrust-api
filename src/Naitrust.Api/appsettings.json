{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NaitrustDbConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "naitrust-api",
    "Audience": "naitrust-client",
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiresInDays": 30
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "naitrust_"
  },
  "Hangfire": {
    "DashboardEnabled": true,
    "DashboardPath": "/hangfire",
    "ConnectionString": ""
  },
  "Providus": {
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "WebhookSecret": "",
    "Sandbox": true
  },
  "QoreId": {
    "BaseUrl": "",
    "ClientId": "",
    "SecretKey": "",
    "Sandbox": true
  },
  "Storage": {
    "Provider": "imagekit",
    "BaseUrl": "",
    "PublicKey": "",
    "PrivateKey": "",
    "UrlEndpoint": ""
  },
  "Email": {
    "Provider": "resend",
    "Host": "",
    "Port": 587,
    "ApiKey": "",
    "FromAddress": "hello@hello.naitrust.com",
    "FromName": "Naitrust",
    "ReplyToAddress": "support@naitrust.com"
  },
  "Sms": {
    "Provider": "termii",
    "ApiKey": "",
    "SenderId": "NaiTrust"
  },
  "OpenAi": {
    "ApiKey": "",
    "DefaultModel": "gpt-4o",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "App": {
    "ApiBaseUrl": "http://localhost:5000",
    "WebBaseUrl": "http://localhost:3000",
    "Environment": "Development"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
